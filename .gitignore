# Working areas (home PC only)
_inbox/*
!_inbox/.gitkeep
archive/

# Data and binary documents never go in the repo
*.sas7bdat
*.sas7bcat
*.sas7bvew
*.xpt
*.xlsx
*.xlsm
*.xls
*.csv
!docs/inventory/*.csv
*.tsv
*.rds
*.RData
*.rda
*.pptx
*.ppt
*.docx
*.doc
*.rtf
*.pdf
*.png
*.jpg
*.zip

# SAS / R byproducts
*.log
*.lst
*.egp
.Rhistory
.Rproj.user/
.RData

# OS
Thumbs.db
desktop.ini
.DS_Store

# D-14: legacy/ whitelist — only code files tracked; data/binary files ignored
legacy/**
!legacy/**/
!legacy/**/*.sas
!legacy/**/*.R
!legacy/**/*.r
!legacy/**/*.Rmd
!legacy/**/*.py
!legacy/**/*.sql
!legacy/**/*.md
!legacy/**/.gitkeep

# D-14: docs/reference/ whitelist — only .md tracked; all binary docs ignored
docs/reference/**
!docs/reference/**/
!docs/reference/**/*.md
!docs/reference/.gitkeep
